# The published image (.github/workflows/reports-image.yml) is built with the defaults below, so pin them in these ARG
# lines (`name:tag@sha256:...`, committed) before tagging a release: a retagged base image must not change a release.
# To move a pin, take the digest of the multi-arch index, not of one platform (a platform digest builds the wrong
# architecture): curl -sI -H "Accept: application/vnd.oci.image.index.v1+json" https://<registry>/v2/<repo>/manifests/<tag>
# A local build can override them with RUST_IMAGE and RUNTIME_IMAGE (compose.build.yaml).
ARG RUST_IMAGE=docker.io/library/rust:1.98-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f

FROM ${RUST_IMAGE} AS build
WORKDIR /src
# decanter-report is a path dependency in the same repository: build with the repository root as the context. What
# the build reads is limited by Containerfile.containerignore.
COPY . /src
WORKDIR /src/crates/reports-server
# s3db is a git dependency (.cargo/config.toml fetches it with the git CLI), so the build stage needs network to
# github.com and crates.io, or a vendored copy.
RUN cargo build --release --locked

# The runtime image has no shell, so /data is made here and copied over with its owner: a new named volume takes
# the ownership of the image's directory, a bind mount does not (docs/deploy.md, "Container"). Only the local
# storage driver uses it; with a bucket the container keeps no state.
RUN install -d -m 0700 -o 65532 -g 65532 /rootfs/data

FROM ${RUNTIME_IMAGE}
COPY --from=build /src/crates/reports-server/target/release/decanter-reports /usr/local/bin/decanter-reports
COPY --from=build --chown=65532:65532 /rootfs/data /data
ENV DECANTER_REPORTS_LISTEN=0.0.0.0:8787 DECANTER_REPORTS_STORAGE_DIR=/data
VOLUME /data
EXPOSE 8787
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/decanter-reports"]
