# Copy to .env next to compose.yaml, mode 0600 (install.sh does it and never overwrites an existing .env). The secrets
# are in this file on purpose: keep it out of git, chat and `docker compose config` pastes.

# The published image, pinned by digest after `gh attestation verify` (install.sh resolves it). Never `latest`.
REPORTS_IMAGE=ghcr.io/yerasuu/decanter-reports@sha256:<digest>

# The public host name, as the browser shows it, and the same address as an origin (the admin session checks it).
REPORTS_HOST=reports.example.org
DECANTER_REPORTS_PUBLIC_URL=https://reports.example.org

# Traefik's address on expose-public as the container sees it (single address): `docker network inspect expose-public`.
DECANTER_REPORTS_TRUSTED_PROXIES=172.20.0.2
# Cloudflare overwrites this header with the address it saw; Traefik passes it on untouched.
DECANTER_REPORTS_CLIENT_IP_HEADER=cf-connecting-ip
# Where the tunnel connects to Traefik from (comma separated addresses or CIDRs); everything else gets a 404.
TUNNEL_SOURCE=172.20.0.3/32

DECANTER_REPORTS_STORAGE_DRIVER=s3
DECANTER_REPORTS_STORAGE_ENDPOINT=https://minio.example.lan:9000
DECANTER_REPORTS_STORAGE_BUCKET=decanter-reports
DECANTER_REPORTS_STORAGE_REGION=us-east-1
DECANTER_REPORTS_STORAGE_PATH_STYLE=true

# Single quotes keep Compose from interpolating a `$` inside a value.
DECANTER_REPORTS_S3_ACCESS_KEY_ID='<access key id>'
DECANTER_REPORTS_S3_SECRET_ACCESS_KEY='<secret access key>'
# From `decanter-reports secret`. Losing it makes the bucket unreadable: keep a copy offline.
DECANTER_REPORTS_PASSPHRASE='<passphrase>'
