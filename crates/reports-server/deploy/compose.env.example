# Copy to .env next to compose.yaml. Nothing secret goes here: the four secrets are files under ./secrets.

# The public host name, as the browser shows it. config.docker.toml's public_url must match.
REPORTS_HOST=reports.yerasuu.com

# Traefik's address on the expose-public network, seen from the container: `docker network inspect expose-public`.
TRAEFIK_IP=172.20.0.2

# Where the tunnel connects to Traefik from, as Traefik sees it: the cloudflared container's address (comma
# separated addresses or CIDRs). Everything else gets a 404 on this host name.
TUNNEL_SOURCE=172.20.0.3/32

# MinIO's address on the home server. Use https:// and a certificate the system store trusts; the bucket, region
# and path style are in config.docker.toml.
S3_ENDPOINT=https://minio.example.lan:9000

# Pin the base images by digest before a real build (docs/deploy.md, "Container").
#RUST_IMAGE=docker.io/library/rust:1.98-bookworm@sha256:...
#RUNTIME_IMAGE=gcr.io/distroless/cc-debian12:nonroot@sha256:...
